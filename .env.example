# Copy this file to .env and fill in your sensitive data
# Do not commit .env to GitHub

# Flask
SECRET_KEY=your-secret-key-here

# SNMP v3 Configuration
SNMP_USER=your-snmp-username
SNMP_AUTH_KEY=your-snmp-auth-key
SNMP_PRIV_KEY=your-snmp-priv-key
SNMP_AUTH_PROTOCOL=usmHMACSHAAuthProtocol
SNMP_PRIV_PROTOCOL=usmDESPrivProtocol
# SNMP_PRIV_PROTOCOL=usmAesCfb128Protocol  # Use if AES is available
# SNMP_PRIV_PROTOCOL=usmAesCfb192Protocol  # Use if AES is available
# SNMP_PRIV_PROTOCOL=usmAesCfb256Protocol  # Use if AES is available

# Database (SQLite by default)
# DATABASE_URI=sqlite:///app.db
# For PostgreSQL: postgresql://user:password@localhost/dbname

# API keys (example)
# API_KEY=your-api-key-here
